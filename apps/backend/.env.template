# =============================================================================
# IndiaGrocers Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- Core Medusa ---
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Generate with: openssl rand -hex 64
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- Database ---
DATABASE_URL=postgresql://medusa:medusa@localhost:5432/indiagrocers

# --- Redis (event bus + cache) ---
REDIS_URL=redis://localhost:6379

# --- Search: MeiliSearch ---
# Self-host on Railway/Render or use MeiliSearch Cloud: https://www.meilisearch.com
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Email: SendGrid ---
# https://sendgrid.com — activate by setting SENDGRID_API_KEY
 SENDGRID_API_KEY=SG.xxxxx_REDACTED
# SENDGRID_FROM=noreply@indiagrocers.co.uk

# --- Email: Resend (alternative to SendGrid) ---
# https://resend.com
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=noreply@indiagrocers.co.uk

# --- SMS: Twilio ---
# https://twilio.com — for order confirmation SMS
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+447700000000

# --- Image Storage: AWS S3 ---
# https://aws.amazon.com/s3/ — for product images
# S3_BUCKET=indiagrocers-product-images
# S3_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Payments: Stripe ---
# https://stripe.com — use test keys for development
 STRIPE_SECRET_KEY=sk_test_REDACTED
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# --- Admin ---
# Set to "true" to disable the Medusa admin dashboard
DISABLE_MEDUSA_ADMIN=false
