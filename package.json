{
  "name": "IndiaGrocers",
  "private": false,
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm -r dev",
    "build": "npm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "packages/*",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "ajv": "^8.0.0"
  },
  "dependencies": {
    "@medusajs/cache-redis": "^2.15.2",
    "@medusajs/event-bus-redis": "^2.15.2",
    "@medusajs/workflow-engine-redis": "^2.15.2"
  }
}
